{
  "description": "Ergana: the session id at session start, the rules in scope before each edit (for the edited file's part of the repository), the done gate on stop (a command hook compares the git checkout's fingerprint with the session's start and the last one a check cleared, and refuses a changed stop once per fingerprint; the agent's check_done then gates), the session's listener (a background hook that wakes an idle session when another agent writes to its person), the session's live state (working, waiting for you, or ended on /clear) and its name, the person\u0027s answer to the confirmation of a committed .ergana file recorded, the check agent kept read-only, and Ergana\u0027s own tools given this session\u0027s id and stripped of the agent\u0027s working folder (no hook sends one), the repository's fingerprint computed (for the check and for the agent's own check_done after a refused stop), the hook-only tools kept to the hooks and the check tools to the check agent.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:ergana:ergana",
            "tool": "before_edit",
            "input": {
              "session_id": "${session_id}",
              "agent_type": "${agent_type}",
              "file_path": "${tool_input.file_path}",
              "plugin_version": "0.16.0"
            },
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/check-readonly.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_ergana_ergana__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ergana-tools.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:ergana:ergana",
            "tool": "session_state",
            "input": {
              "session_id": "${session_id}",
              "state": "waiting",
              "plugin_version": "0.16.0"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/stop.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/inbox.sh",
            "async": true,
            "asyncRewake": true
          },
          {
            "type": "mcp_tool",
            "server": "plugin:ergana:ergana",
            "tool": "check_done",
            "input": {
              "session_id": "${session_id}",
              "background_tasks": "${background_tasks}",
              "plugin_version": "0.16.0"
            },
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:ergana:ergana",
            "tool": "session_state",
            "input": {
              "session_id": "${session_id}",
              "state": "working",
              "plugin_version": "0.16.0"
            },
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/trust-answer.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_ergana_ergana__(check_done|record_check)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/cleared.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:ergana:ergana",
            "tool": "session_state",
            "input": {
              "session_id": "${session_id}",
              "state": "waiting",
              "plugin_version": "0.16.0"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-name.sh",
            "timeout": 10
          },
          {
            "type": "mcp_tool",
            "server": "plugin:ergana:ergana",
            "tool": "session_state",
            "input": {
              "session_id": "${session_id}",
              "state": "working",
              "name": "${session_title}",
              "plugin_version": "0.16.0"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:ergana:ergana",
            "tool": "session_state",
            "input": {
              "session_id": "${session_id}",
              "state": "stopped",
              "plugin_version": "0.16.0"
            },
            "timeout": 10
          }
        ]
      }
    ]
  }
}
