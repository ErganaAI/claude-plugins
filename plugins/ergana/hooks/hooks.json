{
  "description": "Ergana: the session id at session start, the rules in scope before each edit (for the edited file's part of the repository), the done gate on stop (a command hook compares the git checkout's fingerprint with the session's start and the last one a check cleared, and refuses a changed stop once per fingerprint; the agent's check_done then gates), the session's listener (a background hook that wakes an idle session when another agent writes to its person), every call to Ergana made by a command hook that renews the workspace token first, the session's live state (working, waiting for you, or ended on /clear) and its name, the check agent kept read-only, and Ergana\u0027s own tools given this session's id and stripped of the agent's working folder (no hook sends one), the repository's fingerprint computed (for the check and for the agent's own check_done after a refused stop), the hook-only tools kept to the hooks and the check tools to the check agent.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/ergana-hook.py before_edit 30 agent_type=.agent_type file_path=.tool_input.file_path",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/check-readonly.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_ergana_ergana__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/ergana-tools.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/ergana-hook.py session_state 10 state=waiting",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/stop.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/inbox.sh",
            "async": true,
            "asyncRewake": true
          },
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/ergana-hook.py check_done 30 background_tasks=.background_tasks",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/ergana-hook.py session_state 10 state=working",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_ergana_ergana__(check_done|record_check)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/cleared.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/ergana-hook.py session_state 10 state=waiting",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-name.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/ergana-hook.py session_state 10 state=working name=.session_title",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}\"/scripts/ergana-hook.py session_state 10 state=stopped",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
