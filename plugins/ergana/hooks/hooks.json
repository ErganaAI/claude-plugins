{
  "description": "Ergana: the session id at session start, the rules in scope before each edit, the done gate on stop, the session's live state (working or waiting for you) and its name, and the check agent kept read-only.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:ergana:ergana",
            "tool": "before_edit",
            "input": {
              "session_id": "${session_id}",
              "agent_type": "${agent_type}",
              "cwd": "${cwd}",
              "plugin_version": "0.8.0"
            },
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/check-readonly.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:ergana:ergana",
            "tool": "session_state",
            "input": {
              "session_id": "${session_id}",
              "state": "waiting",
              "cwd": "${cwd}",
              "plugin_version": "0.8.0"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:ergana:ergana",
            "tool": "check_done",
            "input": {
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "background_tasks": "${background_tasks}",
              "plugin_version": "0.8.0"
            },
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:ergana:ergana",
            "tool": "session_state",
            "input": {
              "session_id": "${session_id}",
              "state": "working",
              "cwd": "${cwd}",
              "plugin_version": "0.8.0"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:ergana:ergana",
            "tool": "session_state",
            "input": {
              "session_id": "${session_id}",
              "state": "waiting",
              "cwd": "${cwd}",
              "plugin_version": "0.8.0"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-name.sh",
            "timeout": 10
          },
          {
            "type": "mcp_tool",
            "server": "plugin:ergana:ergana",
            "tool": "session_state",
            "input": {
              "session_id": "${session_id}",
              "state": "working",
              "cwd": "${cwd}",
              "name": "${session_title}",
              "plugin_version": "0.8.0"
            },
            "timeout": 10
          }
        ]
      }
    ]
  }
}
